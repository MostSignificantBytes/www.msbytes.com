---
// Page d'erreur 404 (servie par Netlify pour toute adresse inconnue).
import Layout from '../layouts/Layout.astro'
---
<Layout language="fr" path="/">
    <h1 class="error-code">404</h1>
    <div class="cols error-body">
        <div class="col"></div>
        <div class="col">
            <img src="/img/404.jpg" alt="404" />
        </div>
        <div class="col"></div>
    </div>
</Layout>
<style>
    .error-code {
        font-size: 3rem;
        text-align: center;
    }

    .error-body {
        font-size: 3rem;
    }
</style>
