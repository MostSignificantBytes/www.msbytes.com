---
// Page d'erreur 404 (servie par Netlify pour toute adresse inconnue).
import Layout from '../layouts/Layout.astro'
---
<Layout language="fr" path="/">
    <div>
        <h1 class="has-text-centered is-size-1">404</h1>
        <div class="columns is-size-1">
            <div class="column"></div>
            <div class="column">
                <img src="/img/404.jpg" alt="404" />
            </div>
            <div class="column"></div>
        </div>
    </div>
</Layout>
