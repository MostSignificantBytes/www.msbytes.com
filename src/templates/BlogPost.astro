---
// Gabarit « blog-post » : article.
import { render } from 'astro:content'
import { tagPath } from '../utils/site.js'
import labels from '../utils/labels.js'
const { page } = Astro.props
const { title, description, tags, language } = page.data
const { Content } = await render(page)
---
<section class="section">
    <div class="container content">
        <div class="columns">
            <div class="column is-10 is-offset-1">
                <h1 class="title is-size-2 has-text-weight-bold is-bold-light">{title}</h1>
                <p>{description}</p>
                <div><Content /></div>
                {tags && tags.length > 0 && (
                    <div style="margin-top:4rem">
                        <h4>{labels[language].tags}</h4>
                        <ul class="taglist">
                            {tags.map((tag) => <li><a href={tagPath(language, tag)}>{tag}</a></li>)}
                        </ul>
                    </div>
                )}
            </div>
        </div>
    </div>
</section>
