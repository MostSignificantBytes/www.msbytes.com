---
// Gabarit « blog-post » : article.
import { render } from 'astro:content'
import { tagPath } from '../utils/site.js'
import labels from '../utils/labels.js'
const { page } = Astro.props
const { title, description, tags, language } = page.data
const { Content } = await render(page)
---
<article class="section">
    <div class="container prose">
        <div class="cols">
            <div class="col col-10 offset-1">
                <h1 class="post-title">{title}</h1>
                <p>{description}</p>
                <div><Content /></div>
                {tags && tags.length > 0 && (
                    <div class="post-tags">
                        <h2>{labels[language].tags}</h2>
                        <ul class="taglist">
                            {tags.map((tag) => <li><a href={tagPath(language, tag)}>{tag}</a></li>)}
                        </ul>
                    </div>
                )}
            </div>
        </div>
    </div>
</article>
<style>
    .post-title {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 1.5rem;
        word-break: break-word;
    }

    .post-tags {
        margin-top: 4rem;
    }

    /* Titre « Tags » : présentation d'un intertitre de quatrième niveau */
    .post-tags h2 {
        font-size: 1.25em;
        margin-bottom: 0.8em;
        margin-top: 0;
    }
</style>
