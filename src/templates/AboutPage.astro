---
// Gabarit « about-page » : À propos, Notre histoire, Mentions légales.
import { render } from 'astro:content'
const { page } = Astro.props
const { Content } = await render(page)
---
<section class="section section--gradient">
    <div class="container">
        <div class="columns">
            <div class="column is-10 is-offset-1">
                <div class="section">
                    <h2 class="title is-size-3 has-text-weight-bold is-bold-light">{page.data.title}</h2>
                    <div class="content"><Content /></div>
                </div>
            </div>
        </div>
    </div>
</section>
