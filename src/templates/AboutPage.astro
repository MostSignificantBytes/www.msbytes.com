---
// Gabarit « about-page » : À propos, Notre histoire, Mentions légales.
import { render } from 'astro:content'
const { page } = Astro.props
const { Content } = await render(page)
---
<section class="section">
    <div class="container">
        <div class="cols">
            <div class="col col-10 offset-1 reading">
                <article class="section">
                    <h1 class="page-title">{page.data.title}</h1>
                    <div class="prose markdown"><Content /></div>
                </article>
            </div>
        </div>
    </div>
</section>
<style>
    .page-title {
        color: var(--text-strong);
        font-size: 2rem;
        font-weight: 700;
        line-height: 1.125;
        margin-bottom: 1.5rem;
        word-break: break-word;
    }

    /* Intertitres de deuxième niveau affichés à la taille d'un troisième niveau (1,5em) */
    .markdown :global(h2) {
        font-size: 1.5em;
        margin-bottom: 0.6666em;
    }

    .markdown :global(h2:not(:first-child)) {
        margin-top: 1.3333em;
    }
</style>
