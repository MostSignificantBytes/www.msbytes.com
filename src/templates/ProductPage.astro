---
// Gabarit « product-page » : page Activités.
import FullWidthImage from '../components/FullWidthImage.astro'
import Features from '../components/Features.astro'
import Testimonials from '../components/Testimonials.astro'
import Skills from '../components/Skills.astro'
import PreviewImage from '../components/PreviewImage.astro'
import { media } from '../utils/site.js'

const { page } = Astro.props
const { title, image, intro, main, testimonials, full_image: fullImage, skills } = page.data
---
<div class="prose">
    <FullWidthImage img={media(image)} title={title} imgPosition="bottom left" eager />
    <section class="section">
        <div class="container">
            <div class="section">
                <div class="cols">
                    <div class="col col-7 offset-1">
                        <h2 class="activities-heading">{intro.heading}</h2>
                        <p>{intro.description}</p>
                    </div>
                </div>
                <div class="cols">
                    <div class="col col-10 offset-1">
                        <Features gridItems={intro.blurbs} />
                        <div class="cols">
                            <div class="col col-7">
                                <h2 class="activities-subheading">{main.heading}</h2>
                                <p>{main.description}</p>
                            </div>
                        </div>
                        <div class="mosaic">
                            <div class="mosaic-item">
                                <PreviewImage image={main.image1.image} alt={main.image1.alt} width={526} quality={92} />
                            </div>
                            <div class="mosaic-item">
                                <PreviewImage image={main.image2.image} alt={main.image2.alt} width={526} quality={92} />
                            </div>
                            <div class="mosaic-item mosaic-wide">
                                <PreviewImage image={main.image3.image} alt={main.image3.alt} quality={72} />
                            </div>
                        </div>
                        <Testimonials testimonials={testimonials} />
                    </div>
                </div>
            </div>
        </div>
    </section>
    <FullWidthImage img={media(fullImage)} imgPosition="bottom" />
    <section class="section">
        <div class="container">
            <div class="section">
                <div class="cols">
                    <div class="col col-10 offset-1">
                        <h2 class="skills-heading">{skills.heading}</h2>
                        <div class="mosaic">
                            <div class="mosaic-item">
                                <PreviewImage image={skills.image.image} alt={skills.image.alt} quality={90} />
                            </div>
                        </div>
                        <p class="skills-description">{skills.description}</p>
                        <Skills data={skills.list} />
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
<style>
    .activities-heading {
        font-size: 2.5rem;
        margin-bottom: 0.6666em;
    }

    .skills-heading {
        font-size: 2.5rem;
    }

    .activities-subheading {
        font-size: 2rem;
        margin-bottom: 0.6666em;
    }

    /* Mosaïque : deux images côte à côte puis une image pleine largeur (empilées sur téléphone) */
    .mosaic {
        margin: calc(-1 * var(--gap)) calc(-1 * var(--gap)) var(--gap);
    }

    .mosaic:last-child {
        margin-bottom: calc(-1 * var(--gap));
    }

    .mosaic-item {
        flex: 1 1 0;
        padding: var(--gap);
    }

    .mosaic-wide {
        flex-basis: 100%;
    }

    @media (min-width: 769px) {
        .mosaic {
            display: flex;
            flex-wrap: wrap;
        }
    }

    .skills-description {
        font-size: 1.25rem;
    }
</style>
