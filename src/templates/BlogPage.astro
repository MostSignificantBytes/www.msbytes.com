---
// Gabarit « blog-page » : liste des articles.
import FullWidthImage from '../components/FullWidthImage.astro'
import BlogRoll from '../components/BlogRoll.astro'
import { media } from '../utils/site.js'
const { page } = Astro.props
const d = page.data
---
<FullWidthImage img={media(d.image)} title={d.title} eager />
<section class="section">
    <div class="container prose">
        <BlogRoll language={d.language} keepReading={d.keepReading} />
    </div>
</section>
