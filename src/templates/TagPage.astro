---
// Page d'un tag : articles portant ce tag, du plus récent au plus ancien.
import { getPages, prefix } from '../utils/site.js'
import labels from '../utils/labels.js'
const { tag, language } = Astro.props
const posts = (await getPages())
    .filter((entry) => entry.data.language === language && (entry.data.tags || []).includes(tag))
    .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0))
const text = labels[language] || labels.fr
---
<section class="section">
    <div class="container prose">
        <div class="cols">
            <div class="col col-10 offset-1 tag-body">
                <h1 class="tag-title">{text.tagHeader(posts.length, tag)}</h1>
                <ul class="taglist">
                    {posts.map((post) => (
                        <li><a href={post.path}><h2>{post.data.title}</h2></a></li>
                    ))}
                </ul>
                <p><a href={prefix(language) + '/tags/'}>{text.allTags}</a></p>
            </div>
        </div>
    </div>
</section>
<style>
    .tag-body {
        margin-bottom: 6rem;
    }

    /* Titre : présentation d'un intertitre de troisième niveau, en 1,5rem */
    .tag-title {
        font-size: 1.5rem;
        margin-bottom: 1.5rem;
        word-break: break-word;
    }

    .tag-body h2 {
        font-size: 2.5rem;
    }
</style>
