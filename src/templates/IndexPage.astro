---
// Gabarit « index-page » : page d'accueil.
import FullWidthImage from '../components/FullWidthImage.astro'
import Features from '../components/Features.astro'
import BlogRoll from '../components/BlogRoll.astro'
import { media, prefix, SITE_URL } from '../utils/site.js'
import accounts from '../data/social.js'

const { page } = Astro.props
const d = page.data

// Données structurées (schema.org) : fiche de la société pour les moteurs de recherche
const organization = {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': SITE_URL + '/#organization',
    name: 'Most Significant Bytes',
    alternateName: 'MSB',
    legalName: 'Most Significant Bytes SAS',
    url: SITE_URL + '/',
    logo: SITE_URL + '/img/icon_x512.png',
    email: 'contact@msbytes.com',
    address: {
        '@type': 'PostalAddress',
        streetAddress: '10 rue de Penthièvre',
        postalCode: '75008',
        addressLocality: 'Paris',
        addressCountry: 'FR',
    },
    identifier: { '@type': 'PropertyValue', propertyID: 'SIRET', value: '83465164800018' },
    vatID: 'FR60834651648',
    sameAs: accounts.map((account) => account.href),
}
---
<script type="application/ld+json" set:html={JSON.stringify(organization)} />
<FullWidthImage img={media(d.image)} title={d.title} subheading={d.heading} eager />
<section class="section">
    <div class="container">
        <div class="section home-inner">
            <div class="cols">
                <div class="col col-10 offset-1 prose">
                    <div class="prose">
                        <div class="pitch-row">
                            <h2 class="pitch-title">{d.mainpitch.title}</h2>
                        </div>
                        <div class="pitch-row">
                            <p class="pitch-text">{d.mainpitch.description}</p>
                        </div>
                    </div>
                    <div class="cols">
                        <div class="col col-12">
                            <h2 class="home-heading">{d.intro.heading}</h2>
                            <p>{d.intro.description}</p>
                        </div>
                    </div>
                    <Features gridItems={d.intro.blurbs} />
                    <div class="cols">
                        <div class="col col-12 text-center">
                            <a class="btn" href={prefix(d.language) + '/activities/'}>{d.seeAllActivities}</a>
                        </div>
                    </div>
                    <div class="col col-12">
                        <h2 class="home-heading">{d.latestStories}</h2>
                        <BlogRoll language={d.language} keepReading={d.keepReading} headingLevel={3} />
                        <div class="col col-12 text-center">
                            <a class="btn" href={prefix(d.language) + '/blog/'}>{d.ourBlog}</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<style>
    /* Argumentaire : titre de 2em et texte en intertitre de 1,75em */
    .pitch-title {
        font-size: 2em;
        margin-bottom: 0.5em;
    }

    .pitch-text {
        color: var(--text-strong);
        font-size: 1.75em;
        font-weight: 600;
        line-height: 1.125;
        margin-bottom: 0.5714em;
    }

    @media (min-width: 769px) {
        .pitch-row {
            display: flex;
        }
    }

    /* Intertitres de section : présentation d'un titre de troisième niveau, en 2,5rem */
    .home-heading {
        font-size: 2.5rem;
        margin-bottom: 0.6666em;
        margin-top: 0;
    }

    /* Téléphone : texte d'argumentaire en taille de sous-titre, intertitres réduits,
       pas de seconde marge intérieure (le texte occupe toute la largeur disponible) */
    @media (max-width: 768px) {
        .home-inner {
            padding: 0;
        }

        .pitch-title {
            font-size: 1.75em;
        }

        .pitch-text {
            font-size: 1.25em;
            font-weight: 500;
            line-height: 1.4;
        }

        .home-heading {
            font-size: 1.75rem;
        }
    }
</style>
