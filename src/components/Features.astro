---
// Blocs illustrés (image et texte) sur deux colonnes.
import PreviewImage from './PreviewImage.astro'
const { gridItems = [] } = Astro.props
---
<div class="columns is-multiline">
    {gridItems.map((item) => (
        <div class="column is-6">
            <section class="section">
                <div class="has-text-centered">
                    <div style="width:240px;display:inline-block">
                        <PreviewImage image={item.image} alt={item.alt || ''} width={240} quality={64} />
                    </div>
                </div>
                <p>{item.text}</p>
            </section>
        </div>
    ))}
</div>
