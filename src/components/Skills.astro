---
// Compétences : nom, description et liste d'éléments, en colonnes.
const { data = [] } = Astro.props
---
<div class="cols cols-wrap">
    {data.map((skill) => (
        <div class="col skill">
            <div class="section">
                <h2 class="skill-name">{skill.name}</h2>
                <p class="skill-description">{skill.description}</p>
                <ul>
                    {(skill.items || []).map((item) => (
                        <li>{item}</li>
                    ))}
                </ul>
            </div>
        </div>
    ))}
</div>
<style>
    .skill {
        font-size: 1.5rem;
    }

    .skill-name {
        color: var(--msb-blue);
        font-size: 3rem;
        font-weight: 700;
        text-align: center;
    }

    .skill-description {
        font-weight: 600;
    }

    .skill li {
        font-size: 1.25rem;
    }
</style>
