---
// Bandeau image pleine largeur (hauteur maximale 400 px), avec titre et sous-titre superposés.
import { Picture } from 'astro:assets'

const { img, title, subheading, height = 400, imgPosition = 'top left', eager = false } = Astro.props
const widths = [750, 1080, 1366, 1920].filter((w) => w < img.width).concat(Math.min(img.width, 1920))
const titleStyle = 'box-shadow:rgb(0, 51, 153) 0.5rem 0px 0px, rgb(0, 51, 153) -0.5rem 0px 0px;background-color:rgb(0, 51, 153);color:white;line-height:1'
---
<div class="margin-top-0" style="display:grid;align-items:center">
    <Picture
        src={img}
        alt=""
        formats={['webp']}
        widths={widths}
        sizes="100vw"
        quality={80}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        pictureAttributes={{ style: 'grid-area:1/1' }}
        style={`display:block;width:100%;height:auto;max-height:${height}px;object-fit:cover;object-position:${imgPosition}`}
    />
    {(title || subheading) && (
        <div style="grid-area:1/1;position:relative;place-items:center;display:grid">
            {title && (
                <h1 class="has-text-weight-bold is-size-3-mobile is-size-2-tablet is-size-1-widescreen" style={`${titleStyle};padding:0.25em`}>{title}</h1>
            )}
            {subheading && (
                <h2 class="has-text-weight-bold is-size-5-mobile is-size-5-tablet is-size-4-widescreen" style={`${titleStyle};padding:0.25rem;margin-top:0.5rem`}>{subheading}</h2>
            )}
        </div>
    )}
</div>
