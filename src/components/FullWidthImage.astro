---
// Bandeau image pleine largeur (hauteur maximale 400 px), avec titre et sous-titre superposés.
// AVIF (navigateurs récents) puis WebP ; qualité 55 : en AVIF, rendu équivalent au WebP de qualité 80
// pour environ deux fois moins de poids.
import { Picture } from 'astro:assets'

const { img, title, subheading, height = 400, imgPosition = 'top left', eager = false } = Astro.props
const widths = [750, 1080, 1366, 1920].filter((w) => w < img.width).concat(Math.min(img.width, 1920))
---
<div class="hero">
    <Picture
        src={img}
        alt=""
        formats={['avif', 'webp']}
        widths={widths}
        sizes="100vw"
        quality={55}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        style={`max-height:${height}px;object-position:${imgPosition}`}
    />
    {(title || subheading) && (
        <div class="hero-text">
            {title && <h1 class="hero-title">{title}</h1>}
            {subheading && <p class="hero-subtitle">{subheading}</p>}
        </div>
    )}
</div>
<style>
    .hero {
        align-items: center;
        display: grid;
    }

    .hero :global(picture) {
        grid-area: 1 / 1;
    }

    .hero :global(img) {
        display: block;
        height: auto;
        object-fit: cover;
        width: 100%;
    }

    .hero-text {
        display: grid;
        grid-area: 1 / 1;
        place-items: center;
        position: relative;
    }

    /* Texte blanc sur bandeau bleu, prolongé de part et d'autre par une ombre de la même couleur */
    .hero-title,
    .hero-subtitle {
        background-color: var(--msb-blue);
        box-shadow: var(--msb-blue) 0.5rem 0 0, var(--msb-blue) -0.5rem 0 0;
        color: #fff;
        font-weight: 700;
        line-height: 1;
    }

    .hero-title {
        font-size: 2rem;
        padding: 0.25em;
    }

    .hero-subtitle {
        font-size: 1.25rem;
        margin-top: 0.5rem;
        padding: 0.25rem;
    }

    @media (min-width: 769px) {
        .hero-title {
            font-size: 2.5rem;
        }
    }

    @media (min-width: 1216px) {
        .hero-title {
            font-size: 3rem;
        }

        .hero-subtitle {
            font-size: 1.5rem;
        }
    }
</style>
