---
// Liste des articles d'une langue (du plus récent au plus ancien) : vignette, titre, date, extrait.
// headingLevel : niveau du titre des cartes (2 sous le titre de la page du blog, 3 sous l'intertitre de l'accueil).
import { render } from 'astro:content'
import PreviewImage from './PreviewImage.astro'
import { getPosts, formatDate } from '../utils/site.js'

const { language, keepReading, headingLevel = 2 } = Astro.props
const Heading = `h${headingLevel}`
const posts = await Promise.all(
    (await getPosts(language)).map(async (post) => ({
        post,
        excerpt: (await render(post)).remarkPluginFrontmatter.excerpt,
    }))
)
---
<div class="cols cols-wrap">
    {posts.map(({ post, excerpt }) => (
        <div class="col col-6">
            <article class={`post-card${post.data.featuredpost ? ' is-featured' : ''}`}>
                <header class="post-card-header">
                    {post.data.featuredimage && (
                        <div class="post-card-thumbnail">
                            {/* Vignette décorative : le titre de l'article est juste à côté */}
                            <PreviewImage image={post.data.featuredimage} alt="" width={120} quality={90} />
                        </div>
                    )}
                    <div>
                        <Heading class="post-card-heading"><a class="post-card-title" href={post.path}>{post.data.title}</a></Heading>
                        <time class="post-card-date" datetime={post.data.date?.toISOString().slice(0, 10)}>{formatDate(post.data.date, language)}</time>
                    </div>
                </header>
                <p>
                    {excerpt}
                    <br />
                    <br />
                    <a class="button" href={post.path}>{keepReading} →</a>
                </p>
            </article>
        </div>
    ))}
</div>
<style>
    .post-card {
        background-color: var(--background-light);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        color: var(--text-dark);
        display: block;
        margin: 0;
        padding: 1.25rem 2.5rem 1.25rem 1.5rem;
        position: relative;
    }

    .post-card.is-featured {
        background-color: rgb(255 204 0 / 20%);
    }

    .post-card-header {
        display: flex;
        margin-bottom: 1em;
    }

    /* Vignette de largeur fixe : les titres commencent tous au même endroit */
    .post-card-thumbnail {
        flex: none;
        margin: 0 1.25em 0 0;
        width: 120px;
    }

    .post-card-heading {
        font-size: 1.5rem;
        font-weight: 600;
        line-height: 1.125;
        margin-bottom: 0.25em;
    }

    .post-card-title {
        color: var(--msb-blue);
        word-break: break-word;
    }

    .post-card-title:hover,
    .post-card-title:focus {
        color: var(--msb-blue-dark);
        text-decoration: underline;
    }

    .post-card-date {
        color: var(--text);
        display: block;
        font-size: 1rem;
        line-height: 1.25;
    }

    @media (max-width: 768px) {
        .post-card-header {
            display: block;
        }

        .post-card-thumbnail {
            margin: 0 0 1em;
        }
    }
</style>
