---
// Pied de page : logo, liens du menu (trois colonnes sur ordinateur, deux sur téléphone), réseaux sociaux sur une ligne, mentions légales.
import navbar from '../data/navbar.js'
import accounts from '../data/social.js'
import { Image } from 'astro:assets'
import logo from '../assets/logoMSBclair.png'
import linkedin from '../assets/social/linkedin.svg?url'
import facebook from '../assets/social/facebook.svg?url'
import instagram from '../assets/social/instagram.svg?url'
import github from '../assets/social/github.svg?url'

const { language } = Astro.props
const data = navbar.find((item) => item.language === language)
const ICONS = { Linkedin: linkedin, Github: github, Instagram: instagram, Facebook: facebook }
const on = language === 'fr' ? 'MSB sur' : 'MSB on'
const social = accounts.map((account) => ({ href: account.href, src: ICONS[account.name], alt: `${on} ${account.label}` }))
---
<footer class="site-footer">
    <div class="footer-logo">
        <Image src={logo} format="webp" alt="MSB" />
    </div>
    <div class="footer-main">
        <div class="container">
            <div class="cols footer-cols">
                <nav class="footer-nav" aria-label={language === 'fr' ? 'Pied de page' : 'Footer'}>
                    <ul class="footer-links">
                        {data.nav.map((link) => (
                            <li><a href={link.href}>{link.title}</a></li>
                        ))}
                    </ul>
                </nav>
                <ul class="col col-3 footer-reseaux">
                    {social.map((item) => (
                        <li>
                            <a class="footer-reseau" title={item.alt} href={item.href}><img src={item.src} alt={item.alt} /></a>
                        </li>
                    ))}
                </ul>
            </div>
        </div>
    </div>
    <p class="copyright">
        Most Significant Bytes SAS <span class="nowrap">&copy; 2017 - {new Date().getFullYear()}</span>
        <br />
        <a href={data.legal.href}>{data.legal.title}</a>
    </p>
</footer>
<style>
    .site-footer {
        background-color: var(--msb-black);
        color: var(--text-light);
        padding: 3rem 0 0;
    }

    .footer-logo {
        margin-bottom: 1.5rem;
        text-align: center;
    }

    .footer-logo img {
        max-height: 10em;
        width: auto;
    }

    .footer-main {
        margin-bottom: 1.5rem;
        text-align: center;
    }

    .footer-cols {
        max-width: 100vw;
    }

    /* Liens : une liste unique, trois colonnes de deux liens (ordinateur et tablette) */
    .footer-links {
        display: grid;
        grid-auto-flow: column;
        grid-template-columns: repeat(3, 1fr);
        grid-template-rows: repeat(2, auto);
        line-height: 1.25;
        padding-top: calc(var(--gap) + 1em);
        row-gap: 0.25em;
        text-align: left;
    }

    .footer-links li {
        padding: 0 var(--gap) 0 calc(var(--gap) + 2em);
    }

    @media (min-width: 769px) {
        .footer-nav {
            flex: none;
            width: 75%;
        }
    }

    .footer-links a {
        border-radius: 2px;
        color: var(--text-light);
        display: block;
        line-height: 1.5;
        padding: 0.5em 0.75em;
    }

    .footer-links a:hover {
        background-color: var(--background-lighter);
        color: var(--msb-black);
    }

    /* Réseaux sociaux : une ligne d'icônes centrée dans la quatrième colonne (sous les liens sur téléphone) */
    .footer-reseaux {
        align-content: center;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
    }

    .footer-reseau {
        background-color: var(--background-light);
        border-radius: 50%;
        display: block;
        margin: 0.5em;
        padding: 0.5em;
    }

    .footer-reseau img {
        display: block;
        height: 1em;
        width: 1em;
    }

    .copyright {
        padding: 2em;
        text-align: center;
    }

    .nowrap {
        white-space: nowrap;
    }

    /* Téléphone : logo réduit, liens sur deux colonnes, icônes sur une ligne */
    @media (max-width: 768px) {
        .footer-logo img {
            max-width: 60%;
        }

        .footer-links {
            column-gap: 1rem;
            grid-auto-flow: row;
            grid-template-columns: repeat(2, max-content);
            grid-template-rows: none;
            justify-content: center;
            padding-top: 0;
        }

        .footer-links li {
            padding: 0;
        }

        .footer-reseaux {
            margin-top: 1rem;
        }
    }

    .copyright a,
    .copyright a:hover {
        color: var(--text-light);
    }
</style>
