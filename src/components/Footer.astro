---
// Pied de page : logo, liens du menu sur trois colonnes, réseaux sociaux, mentions légales.
import navbar from '../data/navbar.js'
import logo from '../assets/logoMSBclair.png?url'
import linkedin from '../assets/social/linkedin.svg?url'
import facebook from '../assets/social/facebook.svg?url'
import instagram from '../assets/social/instagram.svg?url'
import twitter from '../assets/social/twitter.svg?url'
import github from '../assets/social/github.svg?url'

const { language } = Astro.props
const data = navbar.find((item) => item.language === language)
const columns = [data.nav.slice(0, 2), data.nav.slice(2, 4), data.nav.slice(4, 6)]
// Icônes réparties sur deux rangées de cinq cases (null : case vide)
const social = {
    linkedin: { href: 'https://fr.linkedin.com/company/msbytes', src: linkedin, alt: 'Linkedin' },
    github: { href: 'https://github.com/MostSignificantBytes', src: github, alt: 'Github' },
    twitter: { href: 'https://twitter.com/msbcompany', src: twitter, alt: 'Twitter' },
    instagram: { href: 'https://www.instagram.com/mostsignificantbytes', src: instagram, alt: 'Instagram' },
    facebook: { href: 'https://www.facebook.com/msbytes', src: facebook, alt: 'Facebook' },
}
const rows = [
    [social.linkedin, null, social.github, null, social.twitter],
    [null, social.instagram, null, social.facebook, null],
]
---
<footer class="site-footer">
    <div class="footer-logo">
        <img width="724" height="309" src={logo} alt="MSB" />
    </div>
    <div class="footer-main">
        <div class="container">
            <div class="cols footer-cols">
                {columns.map((links) => (
                    <div class="col col-3">
                        <ul class="footer-links">
                            {links.map((link) => (
                                <li><a href={link.href}>{link.title}</a></li>
                            ))}
                        </ul>
                    </div>
                ))}
                <div class="col col-3">
                    {rows.map((row) => (
                        <div class="cols">
                            {row.map((item) => (
                                <div class="col">
                                    {item && (
                                        <a class="footer-social" title={item.alt.toLowerCase()} href={item.href}><img src={item.src} alt={item.alt} /></a>
                                    )}
                                </div>
                            ))}
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </div>
    <p class="copyright">
        Most Significant Bytes SAS &copy; 2017 - {new Date().getFullYear()}
        <br />
        <a href={data.legal.href}>{data.legal.title}</a>
    </p>
</footer>
<style>
    .site-footer {
        background-color: var(--msb-black);
        color: var(--text-light);
        padding: 3rem 0 0;
    }

    .footer-logo {
        margin-bottom: 1.5rem;
        text-align: center;
    }

    .footer-logo img {
        max-height: 10em;
        width: auto;
    }

    .footer-main {
        margin-bottom: 1.5rem;
        text-align: center;
    }

    .footer-cols {
        max-width: 100vw;
    }

    .footer-links {
        line-height: 1.25;
        margin: 1em 0 0 2em;
        text-align: left;
    }

    .footer-links li + li {
        margin-top: 0.25em;
    }

    .footer-links a {
        border-radius: 2px;
        color: var(--text-light);
        display: block;
        line-height: 1.5;
        padding: 0.5em 0.75em;
    }

    .footer-links a:hover {
        background-color: var(--background-lighter);
        color: var(--msb-black);
    }

    .footer-social {
        background-color: var(--background-light);
        border-radius: 1em;
        margin: 0.5em;
        padding: 0.5em 0.5em 0.3em;
        vertical-align: middle;
    }

    .footer-social img {
        height: 1em;
        width: 1em;
    }

    .copyright {
        padding: 2em;
        text-align: center;
    }

    .copyright a,
    .copyright a:hover {
        color: var(--text-light);
    }
</style>
