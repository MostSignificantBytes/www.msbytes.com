---
// Mise en page commune : en-tête HTML (référencement), barre de navigation, contenu principal, pied de page.
// Styles : variables (tokens.css), base typographique (base.css), mise en page (layout.css) ; chaque composant a les siens.
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
import { SITE_URL, SITE_TITLE, SITE_DESCRIPTION } from '../utils/site.js'
import { unprefixed, prefix } from '../utils/languages.mjs'
// Police Source Sans 3 (licence OFL), hébergée sur le site : seul le jeu latin est téléchargé par les navigateurs
import '@fontsource-variable/source-sans-3/wght.css'
import '@fontsource-variable/source-sans-3/wght-italic.css'
import fontLatin from '@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url'
import '../styles/tokens.css'
import '../styles/base.css'
import '../styles/layout.css'

// image / type : image de partage et type Open Graph propres à la page (articles du blog)
// alternates : adresse de la page dans chaque langue (null si elle n'existe pas) ; à défaut, même adresse sans préfixe
const { language = 'fr', path = '/', title, description, image, type, alternates } = Astro.props

// Versions linguistiques : un code par langue (valable pour tous les pays), plus x-default (version
// proposée aux autres langues : le français, langue par défaut du site)
const HREFLANG = { fr: ['fr', 'x-default'], en: ['en'] }
const ICONS = [48, 72, 96, 128, 192, 384, 512]

const pageTitle = title || SITE_TITLE
const pageDescription = description || SITE_DESCRIPTION
const basePath = unprefixed(path)
const alternate = (lang) => (alternates ? alternates[lang] : prefix(lang) + basePath)
---
<!DOCTYPE html>
<html lang={language}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
        <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />
        <meta name="theme-color" content="#003399" />
        <meta name="description" content={pageDescription} />
        <meta name="theme-color" content="#fff" />
        <meta property="og:type" content={type || 'business.business'} />
        <meta property="og:site_name" content={SITE_TITLE} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={pageDescription} />
        <meta property="og:url" content={SITE_URL + path} />
        <meta property="og:image" content={SITE_URL + (image || '/img/og-image.png')} />
        <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
        <link rel="manifest" href="/manifest.webmanifest" crossorigin="anonymous" />
        {ICONS.map((size) => <link rel="apple-touch-icon" sizes={`${size}x${size}`} href={`/img/maskable_icon_x${size}.png`} />)}
        <title>{pageTitle}</title>
        <link rel="canonical" href={SITE_URL + path} />
        {Object.entries(HREFLANG).map(([lang, codes]) =>
            alternate(lang) && codes.map((code) => <link rel="alternate" href={SITE_URL + alternate(lang)} hreflang={code} />)
        )}
        <link rel="apple-touch-icon" sizes="180x180" href="/img/apple-touch-icon.png" />
        <link rel="icon" type="image/png" href="/img/favicon-32x32.png" sizes="32x32" />
        <link rel="icon" type="image/png" href="/img/favicon-16x16.png" sizes="16x16" />
        <link rel="mask-icon" href="/img/safari-pinned-tab.svg" color="#ff4400" />
    </head>
    <body>
        <Navbar language={language} path={path} alternates={alternates} />
        <main><slot /></main>
        <Footer language={language} />
    </body>
</html>
